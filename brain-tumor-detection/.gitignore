# =============================================================================
# Git Ignore Configuration - BrainSight AI
# Ensures secrets, database files, and bulky node/python artifacts are never committed
# =============================================================================

# Environment variables & secrets
.env
.env.*
!.env.example
!.env.production.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Node & Frontend
node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Databases
*.db
*.sqlite
*.sqlite3
brain_tumor.db
backend/brain_tumor.db

# Ephemeral uploads & generated clinical data (folders preserved via .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep
backend/enhanced_images/*
!backend/enhanced_images/.gitkeep
backend/reports/*
!backend/reports/.gitkeep

# IDEs & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.log
