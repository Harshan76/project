# =============================================================================
# BrainSight AI - Backend Environment Configuration
# =============================================================================

# Flask Port (default 5000)
PORT=5000

# MongoDB Configuration
# For Local MongoDB Server:
MONGODB_URI=mongodb://localhost:27017

# For MongoDB Atlas (replace <username>, <password>, and <cluster>):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority

# Database Name (Brain Tumor Detection)
MONGODB_DB_NAME=brain_tumor_detection

# JWT Authentication Secret Key
JWT_SECRET_KEY=brainsight-neuro-oncology-secure-secret-key-2026
JWT_EXPIRATION_HOURS=24
BCRYPT_ROUNDS=12

# Resilient Local Fallback (true allows in-memory PyMongo mock when offline)
ALLOW_MOCK_FALLBACK=true
