# =============================================================================
# BrainSight AI Frontend - Environment Variables
# =============================================================================

# In Production on Vercel:
# Set VITE_API_BASE_URL to your deployed Render backend URL (no trailing slash)
# Example: https://brainsight-backend.onrender.com
VITE_API_BASE_URL=https://your-brainsight-backend.onrender.com

# In Local Development:
# Leave empty so Vite forwards requests to http://localhost:5000 via local proxy
# VITE_API_BASE_URL=
